# Vault402 environment variables — copy to .env and fill in. Never commit .env.

# --- Hedera testnet (settlement chain) ---
# Hedera account id of the operator/buyer, e.g. 0.0.123456
HEDERA_OPERATOR_ID=
# Operator private key. Must be ECDSA — parse explicitly as ECDSA, never implicit/generic.
# Never commit a real value; for local dev only. In the agent path this should come from
# the Ledger Key Ring gate, not a raw env var (see CLAUDE.md "non-negotiable technical facts").
HEDERA_OPERATOR_KEY=

# --- Blocky402 facilitator (x402 v2, Hedera settlement) ---
# Base URL of the Blocky402 facilitator. The fee-payer account is fetched live from
# this facilitator's /supported endpoint at runtime — never hardcode a fee-payer id.
BLOCKY402_FACILITATOR_URL=

# --- The Graph / Subgraph Studio ---
# Live Subgraph Studio API key. Required for querying/deploying the PurchaseLog subgraph
# on Ethereum Sepolia (network id: sepolia). Mocked/static data disqualifies the Graph track.
SUBGRAPH_STUDIO_API_KEY=
# Full query URL for the deployed subgraph, e.g.
# https://api.studio.thegraph.com/query/<id>/<subgraph-name>/<version>
SUBGRAPH_QUERY_URL=

# --- Ledger Key Ring / wallet-cli ---
# Password protecting the Ledger Key Ring (LKRP). MUST be injected at runtime via OS
# keychain command substitution, e.g.:
#   WALLET_PASS=$(security find-generic-password -a default -s ledger-wallet-cli -w)
# Never set this to a literal value here or on the command line — it leaks to shell
# history, `ps`, and CI logs. An empty value must abort auth, not silently skip it.
WALLET_PASS=
