# Vault402 environment variables — copy to .env and fill in. Never commit .env.

# --- Hedera testnet (settlement chain) ---
# Hedera account id of the operator/buyer, e.g. 0.0.123456. Not secret.
HEDERA_OPERATOR_ID=
# Path to the Hedera operator private key, encrypted at rest via
# `wallet-cli ring encrypt --key $RING_KEY_NAME`. Decrypted in-process at runtime via
# `wallet-cli ring decrypt` (see src/ledger/gate.ts) — never stored or committed
# unencrypted. Must be ECDSA — parse explicitly as ECDSA, never implicit/generic.
HEDERA_OPERATOR_KEY_ENC_PATH=
# Name the operator key was encrypted under (the `--key` value passed to
# `ring encrypt`/`ring decrypt`). Free-form, e.g. vault402-hedera-operator.
RING_KEY_NAME=

# --- Blocky402 facilitator (x402 v2, Hedera settlement) ---
# Base URL of the Blocky402 facilitator. The fee-payer account is fetched live from
# this facilitator's /supported endpoint at runtime — never hardcode a fee-payer id.
BLOCKY402_FACILITATOR_URL=

# --- Ethereum Sepolia (PurchaseLog contract) ---
# FINAL DESIGN: the Ledger Key Ring gate is scoped to the Hedera operator key only.
# The PurchaseLog write on Ethereum Sepolia uses a plain env-var key below — no
# Ledger/DMK/ring involvement here. Never commit a real value; local dev / low-value
# testnet key only.
ETHEREUM_SEPOLIA_PRIVATE_KEY=
# RPC endpoint used to submit the PurchaseLog.recordPurchase transaction.
ETHEREUM_SEPOLIA_RPC_URL=

# --- The Graph / Subgraph Studio ---
# Live Subgraph Studio API key. Required for querying/deploying the PurchaseLog subgraph
# on Ethereum Sepolia (network id: sepolia). Mocked/static data disqualifies the Graph track.
SUBGRAPH_STUDIO_API_KEY=
# Full query URL for the deployed subgraph. Query through
# gateway-arbitrum.network.thegraph.com, not gateway.thegraph.com — the latter returned
# a misleading "API key not found" for a valid key during Phase 1 checks. Format:
# https://gateway-arbitrum.network.thegraph.com/api/<key>/subgraphs/id/<subgraph-id>
SUBGRAPH_QUERY_URL=

# --- Ledger Key Ring / wallet-cli ---
# Password protecting the Ledger Key Ring (LKRP). Gates `ring encrypt`/`ring decrypt`
# for the Hedera operator key only (see above) — MUST be injected at runtime via OS
# keychain command substitution, e.g.:
#   WALLET_PASS=$(security find-generic-password -a default -s ledger-wallet-cli -w)
# Never set this to a literal value here or on the command line — it leaks to shell
# history, `ps`, and CI logs. An empty value must abort auth, not silently skip it.
WALLET_PASS=
