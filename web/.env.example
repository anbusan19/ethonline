# Vault402 web — environment variables. Copy to .env.local and fill in.
# Never commit .env.local (see root .gitignore).

# Live vault-402 subgraph query URL. Server-only (no NEXT_PUBLIC_ prefix — the graph
# view is computed server-side in app/api/graph/route.ts, never fetched from the
# browser). Query via gateway-arbitrum.network.thegraph.com or Studio's own endpoint
# — see root .env.example for the full note on which gateway host actually works.
SUBGRAPH_QUERY_URL=
